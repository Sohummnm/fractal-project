<?xml version="1.0" encoding="UTF-8"?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.company.frontend.controller.MainController"
      spacing="10" padding="20">

    <HBox spacing="10">
        <TextField fx:id="nameField" promptText="Name"/>
        <TextField fx:id="roleField" promptText="Role"/>
        <Button text="Add" onAction="#addEmployee"/>
    </HBox>

    <TableView fx:id="employeeTable">
        <columns>
            <TableColumn fx:id="id" text="ID"/>
            <TableColumn fx:id="name" text="Name"/>
            <TableColumn fx:id="role" text="Role"/>
        </columns>
    </TableView>

</VBox>
